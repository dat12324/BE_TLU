NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tluphone
CLIENT_ORIGIN=http://localhost:3000
# Bắt buộc cho đăng nhập/lấy thông tin tài khoản: khóa bí mật ngẫu nhiên ít nhất 32 byte. Không đưa vào hệ thống quản lý phiên bản.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Redis Cloud URL: redis:// or rediss://. Never commit real credentials.
REDIS_URL=
# A separate random JWT signing secret of at least 32 bytes.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
# Trusted public backend URL used to build email verification links.
API_BASE_URL=http://localhost:5000
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Chưa bắt buộc cho đến khi sử dụng lưu trữ ảnh. Thông tin xác thực chỉ dùng ở phía máy chủ.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
